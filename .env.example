# --- Required ---
# Bot token from @BotFather. Keep it secret — never commit the real value.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Numeric chat id of the channel/group/user that receives reports.
TELEGRAM_CHAT_ID=replace_with_numeric_chat_id

# --- Optional ---
# Where the JSON state file lives (relative to the repo root when run via CI).
STATE_PATH=data/state.json
# Set to "true" to skip Telegram long-polling and rely on the Cloudflare webhook
# (the GitHub Actions schedule runs in webhook mode).
TELEGRAM_WEBHOOK_MODE=false

# --- Runtime behavior (currently fixed defaults; see src/sndk_bot/config.py) ---
# TZ identifier used for the mandatory-report windows and report timestamps.
# TIMEZONE=Asia/Riyadh
# Exchange calendar for US trading days (XNYS = New York Stock Exchange).
# MARKET_CALENDAR=XNYS
